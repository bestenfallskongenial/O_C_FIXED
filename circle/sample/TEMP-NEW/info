void CKernel::MIDIPacketHandler(
    unsigned cable,
    u8* packet,
    unsigned length,
    unsigned device,
    void* param)
{
    CKernel* kernel =
        static_cast<CKernel*>(param);

    if (length < 3)
        return;

    const u8 status  = packet[0];
    const u8 data1   = packet[1];
    const u8 data2   = packet[2];

    const u8 command = status & 0xF0;
    const u8 channel = status & 0x0F;

    if (channel != kernel->g_midiChannel)
        return;

    if (command == 0xB0)       // Control Change
    {
        for (unsigned lane = 0; lane < 8; ++lane)
        {
            if (data1 == kernel->g_midiCC[lane])
            {
                kernel->g_midiInt[lane] =
                    (data2 * 1023 + 63) / 127;

                kernel->g_midiFlt[lane] =
                    kernel->g_midiInt[lane] / 1024.0f;

                break;
            }
        }
    }
}
