void CKernel::frameTimingBreak()
{
    glFlush();

    const u32 now_us =
        m_Timer.GetClockTicks();

    m_frameTiming.work_time_us =
        now_us - m_frameTiming.frame_start_us;

    m_frameTiming.sleep_time_us = 0;

    if (m_frameTiming.limit_enabled)
    {
        const u32 predicted_total_us =
            m_frameTiming.work_time_us +
            m_frameTiming.swap_time_us;

        if (predicted_total_us < m_frameTiming.target_period_us)
        {
            m_frameTiming.sleep_time_us =
                m_frameTiming.target_period_us -
                predicted_total_us;

            usDelay(m_frameTiming.sleep_time_us);
        }
    }

    m_frameTiming.before_swap_us =
        m_Timer.GetClockTicks();
}
