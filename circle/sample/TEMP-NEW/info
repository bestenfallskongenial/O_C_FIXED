3.5 End-frame/FPS function
void CKernel::frameTimingEnd()
{
    const u32 frame_end_us =
        m_Timer.GetClockTicks();

    m_frameTiming.swap_time_us =
        frame_end_us - m_frameTiming.before_swap_us;

    m_frameTiming.frame_time_us =
        frame_end_us - m_frameTiming.frame_start_us;

    if (m_frameTiming.frame_time_us == 0)
    {
        return;
    }

    m_frameTiming.fps_instant =
        1000000.0f /
        static_cast<float>(m_frameTiming.frame_time_us);

    if (!m_frameTiming.initialized)
    {
        m_frameTiming.fps_display =
            m_frameTiming.fps_instant;

        m_frameTiming.initialized = true;
    }
    else
    {
        constexpr float display_weight = 0.10f;

        m_frameTiming.fps_display +=
            (m_frameTiming.fps_instant -
             m_frameTiming.fps_display) *
            display_weight;
